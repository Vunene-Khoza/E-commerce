# Server Port
PORT=8000

# Node Environment (development, production, test)
NODE_ENV=development

# MongoDB Connection URL
# For standalone local instance:
DATABASE_CONN_URL=mongodb://localhost:27017

# For 3-Node Replica Set (Docker):
# DATABASE_CONN_URL=mongodb://localhost:27017,localhost:27018,localhost:27019/ecommerce?replicaSet=rs0

# Database Name
DB_NAME=ecommerce

# Allowed CORS Origins (comma-separated or wildcard)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Read & Write Concern Policies
DB_WRITE_CONCERN=majority
DB_READ_PREFERENCE=secondaryPreferred
